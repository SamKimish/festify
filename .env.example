# Your Spotify app's Client ID (https://developer.spotify.com/dashboard).
# Copy this file to .env.local and fill it in. The Client ID is not secret
# (the app uses PKCE, so there is no client secret in the browser).
VITE_SPOTIFY_CLIENT_ID=

# Only needed for `npm run resolve-ids` (never shipped to the browser).
SPOTIFY_CLIENT_SECRET=
